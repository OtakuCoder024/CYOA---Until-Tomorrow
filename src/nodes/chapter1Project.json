  "content": [
    {
      "type": "paragraph",
      "text": "Lance ignored the notifications."
    },

    {
      "type": "paragraph",
      "text": "Whatever was happening in Manila could wait."
    },

    {
      "type": "paragraph",
      "text": "The bug couldn't."
    },

    {
      "type": "paragraph",
      "text": "After another twenty minutes of testing, recompiling, and questioning his own intelligence, he finally found the problem."
    },

    {
      "type": "paragraph",
      "text": "A missing condition. One line."
    },

    {
      "type": "paragraph",
      "text": "The device sprang to life."
    },

    {
      "type": "paragraph",
      "text": "A small victory, but a satisfying one."
    },

    {
      "type": "paragraph",
      "text": "His phone buzzed several more times."
    },

    {
      "type": "paragraph",
      "text": "He ignored those too."
    }
  ],

